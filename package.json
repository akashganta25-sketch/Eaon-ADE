{
  "name": "eaon-ade",
  "version": "1.1.5",
  "description": "Eaon ADE — an agentic development environment. Run many CLI coding agents side by side.",
  "main": "./out/main/index.js",
  "author": "Eaon",
  "license": "MIT",
  "homepage": "https://github.com/sanscreates/Eaon-ADE",
  "desktopName": "eaon-ade.desktop",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "check:integrations": "node scripts/check-integrations.mjs",
    "check:worktrees": "node scripts/check-worktrees.mjs",
    "check:tasks": "node scripts/check-tasks.mjs",
    "check:sessions": "node scripts/check-sessions.mjs",
    "check:preview": "node scripts/check-preview.mjs",
    "check:accounts": "node scripts/check-accounts.mjs",
    "check:codex-usage": "node scripts/check-codex-usage.mjs",
    "check:usage-refresh": "node scripts/check-usage-refresh.mjs",
    "check:gpu-contexts": "node scripts/check-gpu-contexts.mjs",
    "check:memory": "node scripts/check-memory.mjs",
    "check:ssh": "node scripts/check-ssh.mjs",
    "check:ssh-worktrees": "node scripts/check-ssh-worktrees.mjs",
    "test:brain": "node scripts/test-brain-skill.mjs",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-builder install-app-deps",
    "dist:mac": "npm run build && electron-builder --mac",
    "deps:win": "node scripts/fetch-win-deps.mjs",
    "dist:win": "npm run build && npm run deps:win && node scripts/dist-win.mjs",
    "dist:linux": "npm run build && node scripts/dist-linux.mjs",
    "icon": "node scripts/make-icon.mjs 1024 resources/icon.png",
    "dist:mac:release": "npm run dist:mac && node scripts/notarize-mac.mjs",
    "verify:mac": "node scripts/verify-mac.mjs",
    "notarize:mac": "node scripts/notarize-mac.mjs",
    "release:github": "node scripts/publish-release.mjs",
    "check:automations": "node scripts/check-automation-schedule.mjs",
    "check:handoff": "node scripts/check-handoff.mjs",
    "check:linux": "node scripts/check-linux.mjs",
    "check:agents": "node scripts/check-agent-detect.mjs",
    "check:roster": "node scripts/check-roster.mjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@huggingface/transformers": "^4.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.13",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.28.0",
    "marked": "^18.0.9",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-icons": "^16.28.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6"
  }
}
